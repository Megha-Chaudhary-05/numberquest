{
  "name": "numberquest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty",
    "icons": "node scripts/generate-icons.mjs",
    "test": "tsx scripts/test-logic.ts && tsx scripts/test-ui.ts",
    "test:logic": "tsx scripts/test-logic.ts",
    "test:ui": "tsx scripts/test-ui.ts",
    "check": "tsc -b && oxlint && npm test",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "framer-motion": "^13.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "description": "A colourful 2D maths puzzle adventure for ages 11-20."
}
